{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "icons": {
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Zammad Ticket Extractor",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "clipboardWrite",
    "downloads",
    "storage",
    "scripting",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
